{
  "mcpServers": {
    "ida-pro-mcp": {
      "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "tools/rea/run-ida.ps1"]
    },
    "rea": {
      "command": "powershell.exe",
      "args": ["-NoProfile", "-File", "tools/rea/run.ps1", "mcp"]
    },
    "ghidra-mcp": {
      "command": "bridge-mcp-ghidra",
      "args": ["--transport", "stdio"],
      "env": {
        "GHIDRA_MCP_URL": "http://127.0.0.1:8089"
      }
    }
  }
}
