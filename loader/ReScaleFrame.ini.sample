# ReScaleFrame for AC7. Copy beside Ace7Game.exe as ReScaleFrame.ini.
# Insert opens the overlay. It offers Enable upscaling, backend selection and the quality presets.
# DLSS and reinsertion start automatically after the renderer is ready.
# Enable and quality choices are saved in %LOCALAPPDATA%\ReScaleFrame\AC7.ini and
# take precedence over these defaults. Alternate backend selection is per session.
RSF_DLSS_ENABLE=1
# 0 Native (DLAA), 1 Quality, 2 Balanced, 3 Performance, 4 Ultra Performance.
RSF_DLSS_QUALITY=3

# DLSS-only colour correction after evaluation. It pulls the output toward the current
# jittered frame and adds edge shimmer in the hangar. 0 off (default), 1 on for comparison.
RSF_DLSS_COLOUR_CORRECTION=0
# DLSS sees an invertible display-range encoding of the scene (HDR input off) and its output is
# decoded back to linear. Removes the dark banding of the auto-exposing presets (L, M) on any
# preset or driver override. 1 on (default), 0 sends linear HDR for comparison.
RSF_DLSS_TONEMAP=1

# Briefing resolution is relative to output, never the reduced scene.
# 100 renders the briefing at full output resolution, independently of the DLSS preset.
RSF_TRANSLUCENCY_TARGET=100
# Draw with an unjittered VS/PS view, then composite after scene SR.
# 0 selects the experimental jittered 1:1 layer resolve for comparison.
RSF_TRANSLUCENCY_UNJITTER=1

# Advanced diagnostics. Ordinary use requires none of these overrides.
# RSF_OBSERVE=1
# RSF_ENABLE_JITTER=1
# RSF_UI_CLASSIFY=1
# RSF_UI_UNJITTER=1
# RSF_STREAMLINE_BIN=              # defaults to ReScaleFrame\streamline beside the proxy
# RSF_FFX_BIN=                    # defaults to ReScaleFrame\fidelityfx; SDK 2.3 provides FSR2/3/4
# RSF_FSR2_BIN=                   # optional separate SDK directory for FSR2
# RSF_FSR3_BIN=                   # optional separate SDK directory for FSR3
# RSF_FSR4_BIN=                   # optional separate SDK directory for FSR4
# RSF_XESS_BIN=                   # defaults to ReScaleFrame\xess, holding libxess.dll
# RSF_DUMP_DIR=                    # defaults to %LOCALAPPDATA%\ReScaleFrame\AC7
# RSF_DUMP_MODULE=0               # executable dumps are opt-in
# RSF_MOTION_CAPTURE=1            # F9: bounded AC7 motion research capture (60 present intervals)
# RSF_TRANSLUCENCY_SCALE=0        # overrides the output-relative target when nonzero
# RSF_REINSERT_DEPTH=0            # existing overlay-depth policy
# RSF_RENDERDOC=0                 # cannot be used alongside DLSS in the observed setup
